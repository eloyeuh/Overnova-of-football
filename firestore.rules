rules_version = '2';
// Règles de sécurité de la base Firestore : à coller dans console Firebase › Firestore Database › Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Par défaut : toute personne connectée avec Google peut jouer.
    // Pour réserver le jeu à tes amis, remplace la ligne suivante par (avec les vraies adresses) :
    //   function allowed() { return signedIn() && request.auth.token.email in ['toi@gmail.com', 'ami1@gmail.com', 'ami2@gmail.com']; }
    function allowed() { return signedIn(); }

    // Administrateur de la partie : le premier compte connecté, ne peut plus être modifié depuis le site
    match /admin/owner {
      allow read: if allowed();
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Données du jeu
    match /{coll}/{doc} {
      allow read, write: if allowed() && coll in ['game', 'clubs', 'offers', 'ledger', 'auctions', 'cups', 'league', 'matches', 'locks'];
    }
  }
}
